{
  "manifest_schema": "nexus.capability-pack.v1",
  "package_id": "nexus.scene.imaging",
  "version": "1.0.0",
  "display_name": "Local scene imaging: object insertion, inpaint, outpaint, optics and atmosphere",
  "download_size_mb": 5.0,
  "capabilities": [
    "scene.insert_object_with_shadow",
    "scene.remove_object_inpaint",
    "scene.outpaint_canvas_expand",
    "scene.synthesize_depth_of_field",
    "scene.add_volumetric_fog_haze",
    "scene.lens_distortion_correct",
    "scene.chromatic_aberration_control",
    "scene.perspective_horizon_level",
    "scene.sky_replacement_relit",
    "scene.reflection_water_glass_synth",
    "scene.harmonize_radiative_transfer",
    "scene.retime_optical_flow",
    "scene.tonemap_hdr",
    "scene.film_emulation"
  ],
  "runtime": {
    "native": {
      "adapter_id": "nagar.local.scene.imaging.v1",
      "sandbox": "process_isolated",
      "network_required": false
    },
    "browser": {
      "preferred": "onnx_webgpu",
      "fallback": "onnx_wasm_simd",
      "worker_required": true
    }
  },
  "permissions": [
    "read_project_images",
    "write_scene_layers",
    "write_timeline_layers"
  ],
  "network_policy": {
    "upload_media": false,
    "runtime_network": false,
    "pack_update": "optional_signed_download"
  },
  "hardware_requirements": {
    "minimum_ram_mb": 2048,
    "recommended_ram_mb": 4096,
    "minimum_cpu_threads": 2,
    "gpu": {
      "optional": true,
      "webgpu": true
    },
    "disk_free_mb": 500
  },
  "artifacts": [],
  "resource_budget": {
    "max_resident_model_mb": 150,
    "max_audio_minutes_in_memory": 5.0,
    "max_preview_resolution": "1920x1080"
  },
  "compatibility": {
    "min_nagar_version": "3.10.0",
    "protocol_version": "nagar.command.v1",
    "state_schema": "nagar.state.v1"
  },
  "security": {
    "signature_algorithm": "ed25519",
    "signature": "base64:placeholder-scene-signature",
    "trusted_publisher": "nagar-core",
    "allow_arbitrary_native_code": false,
    "allow_arbitrary_wasm_imports": false
  },
  "external_binaries": []
}
