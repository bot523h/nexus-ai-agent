{
  "manifest_schema": "nexus.capability-pack.v1",
  "package_id": "nexus.edit.timeline",
  "version": "1.0.0",
  "display_name": "Local non-destructive timeline editing, trimming, ripple delete, and speed ramping",
  "download_size_mb": 20.0,
  "capabilities": [
    "timeline.trim",
    "timeline.ripple_delete",
    "timeline.insert_gap",
    "timeline.speed_ramp",
    "timeline.reverse_segment",
    "timeline.freeze_frame",
    "timeline.attach_b_roll",
    "timeline.retime_to_music",
    "timeline.sync_multicam"
  ],
  "runtime": {
    "native": {
      "adapter_id": "nagar.local.timeline.reducer.v1",
      "sandbox": "process_isolated",
      "network_required": false
    },
    "browser": {
      "preferred": "onnx_webgpu",
      "fallback": "onnx_wasm_simd",
      "worker_required": true
    }
  },
  "permissions": [
    "read_project_video_frames",
    "write_timeline_layers",
    "mutate_timeline_structure"
  ],
  "network_policy": {
    "upload_media": false,
    "runtime_network": false,
    "pack_update": "optional_signed_download"
  },
  "hardware_requirements": {
    "minimum_ram_mb": 2048,
    "recommended_ram_mb": 4096,
    "minimum_cpu_threads": 2,
    "gpu": {
      "optional": true,
      "webgpu": true
    },
    "disk_free_mb": 500
  },
  "artifacts": [],
  "resource_budget": {
    "max_resident_model_mb": 100,
    "max_audio_minutes_in_memory": 5.0,
    "max_preview_resolution": "1920x1080"
  },
  "compatibility": {
    "min_nagar_version": "3.10.0",
    "protocol_version": "nagar.command.v1",
    "state_schema": "nagar.state.v1"
  },
  "security": {
    "signature_algorithm": "ed25519",
    "signature": "base64:placeholder-edit-signature",
    "trusted_publisher": "nagar-core",
    "allow_arbitrary_native_code": false,
    "allow_arbitrary_wasm_imports": false
  },
  "external_binaries": []
}
