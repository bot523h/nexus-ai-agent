{
  "manifest_schema": "nexus.capability-pack.v1",
  "package_id": "nexus.analysis.perception",
  "version": "1.0.0",
  "display_name": "Local media perception: measured silence, scene-cut and loudness evidence",
  "download_size_mb": 0.1,
  "capabilities": [
    "analysis.mark_silences",
    "analysis.mark_scene_cuts",
    "analysis.assess_loudness"
  ],
  "runtime": {
    "native": {
      "adapter_id": "nagar.local.ffmpeg.analysis.v1",
      "sandbox": "process_isolated",
      "network_required": false
    },
    "browser": {
      "preferred": "none",
      "fallback": "none",
      "worker_required": false
    }
  },
  "permissions": [
    "read_project_audio",
    "read_project_video_frames",
    "write_timeline_layers"
  ],
  "network_policy": {
    "upload_media": false,
    "runtime_network": false,
    "pack_update": "forbidden"
  },
  "hardware_requirements": {
    "minimum_ram_mb": 512,
    "recommended_ram_mb": 1024,
    "minimum_cpu_threads": 1,
    "gpu": {
      "optional": true,
      "webgpu": false,
      "features": []
    },
    "disk_free_mb": 100
  },
  "artifacts": [],
  "resource_budget": {
    "max_resident_model_mb": 0,
    "max_audio_minutes_in_memory": 1,
    "max_preview_resolution": "1280x720"
  },
  "compatibility": {
    "min_nagar_version": "3.10.0",
    "protocol_version": "nagar.command.v1",
    "state_schema": "nagar.state.v1"
  },
  "security": {
    "signature_algorithm": "ed25519",
    "signature": "base64:placeholder-signed-manifest",
    "trusted_publisher": "nagar-core",
    "allow_arbitrary_native_code": false,
    "allow_arbitrary_wasm_imports": false
  },
  "external_binaries": [
    "ffmpeg"
  ]
}
