{
  "manifest_schema": "nexus.capability-pack.v1",
  "package_id": "nexus.color.delivery",
  "version": "1.0.0",
  "display_name": "Local color grading, LUT profiles, proxy generation, and OTIO delivery",
  "download_size_mb": 45.0,
  "capabilities": [
    "color.apply_lut",
    "color.adjust_exposure",
    "color.auto_balance",
    "color.match_shot",
    "delivery.make_proxy_480p",
    "delivery.export_otio",
    "delivery.render_master_4k"
  ],
  "runtime": {
    "native": {
      "adapter_id": "nagar.local.color.delivery.v1",
      "sandbox": "process_isolated",
      "network_required": false
    },
    "browser": {
      "preferred": "onnx_webgpu",
      "fallback": "onnx_wasm_simd",
      "worker_required": true
    }
  },
  "permissions": [
    "read_project_video_frames",
    "write_color_layers",
    "write_derived_delivery_assets",
    "export_timeline_interchange"
  ],
  "network_policy": {
    "upload_media": false,
    "runtime_network": false,
    "pack_update": "optional_signed_download"
  },
  "hardware_requirements": {
    "minimum_ram_mb": 4096,
    "recommended_ram_mb": 8192,
    "minimum_cpu_threads": 4,
    "gpu": {
      "optional": true,
      "webgpu": true
    },
    "disk_free_mb": 1000
  },
  "artifacts": [],
  "resource_budget": {
    "max_resident_model_mb": 200,
    "max_audio_minutes_in_memory": 10.0,
    "max_preview_resolution": "1920x1080"
  },
  "compatibility": {
    "min_nagar_version": "3.10.0",
    "protocol_version": "nagar.command.v1",
    "state_schema": "nagar.state.v1"
  },
  "security": {
    "signature_algorithm": "ed25519",
    "signature": "base64:placeholder-delivery-signature",
    "trusted_publisher": "nagar-core",
    "allow_arbitrary_native_code": false,
    "allow_arbitrary_wasm_imports": false
  },
  "external_binaries": []
}
