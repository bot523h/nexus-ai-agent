TELEGRAM_BOT_TOKEN=
NEXUS_OWNER_TELEGRAM_ID=
GEMINI_API_KEY=
BOT_USERNAME=
NEWS_API_KEY=
YOUTUBE_API_KEY=
PRESENCE_TTL=3600
# Self-update path (owner-only + explicit approval). Default: off.
AUTO_UPDATE=false
HEALTH_CHECK_INTERVAL=60
MAX_RAM_MB=1500
FEEDBACK_ENABLED=true
GDRIVE_BEARER_TOKEN=
MEGA_EMAIL=
MEGA_PASSWORD=
# ── Dashboard ──
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0

# ── Core paths ──
# Sandbox root for the file tools and the restricted shell tool.
NEXUS_WORKSPACE_ROOT=.
# Postgres/Neon connection URL (optional). When set, the app DB and LangGraph
# checkpoints use PostgreSQL instead of the local SQLite files below.
# Create a free database at https://console.neon.tech → "Connect" and use the
# connection string (pooled endpoint, port 6543), e.g.
# NEXUS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supported schemes: postgresql://, postgres://, postgresql+asyncpg://
# Leave empty to keep using the local SQLite files.
NEXUS_DATABASE_URL=
NEXUS_DB_PATH=data/app.sqlite
NEXUS_CHECKPOINT_PATH=data/langgraph.sqlite
NEXUS_VECTOR_PATH=data/vector.sqlite
NEXUS_MODEL_PATH=models/model.gguf
NEXUS_CACHE_DIR=data/cache

# ── v3.7.0: Multi-provider LLM routing (Ollama → Groq → Gemini → OpenRouter) ──
# Priority chain built with litellm.Router. Only providers with credentials/
# settings configured enter the chain. Get free keys at:
#   Groq: https://console.groq.com | Gemini: https://aistudio.google.com
#   OpenRouter: https://openrouter.ai
# Master switch — when false, the bot uses the legacy local GGUF / FakeLLM path.
NEXUS_LLM_ROUTING_ENABLED=true
# Drop providers that may train on user prompts (OpenRouter ":free" endpoints).
NEXUS_LLM_STRICT_PRIVACY=false
# Cooldown (seconds) for a cloud provider after its first 429 — 86400 parks it
# for ~24h instead of hammering a drained daily quota (anti retry-storm).
NEXUS_LLM_CLOUD_COOLDOWN=86400
NEXUS_LLM_REQUEST_TIMEOUT=60
# 1) Ollama — local & unlimited. Leave the model empty to disable this leg.
NEXUS_OLLAMA_BASE_URL=http://localhost:11434
NEXUS_OLLAMA_MODEL=
# 2) Groq free tier (llama-3.3-70b-versatile ≈ 1000 req/day).
GROQ_API_KEY=
NEXUS_GROQ_MODEL=llama-3.3-70b-versatile
# 3) Gemini free tier — already configured above via GEMINI_API_KEY.
# 4) OpenRouter last resort. NOTE: some ":free" endpoints may train on prompts;
# set NEXUS_LLM_STRICT_PRIVACY=true to exclude them from the chain.
OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── v3.8.0: Telegram webhook mode (scale-to-zero: Koyeb web service, …) ──
# "polling" (default) or "webhook". The CLI --mode flag wins over this value.
NEXUS_RUN_MODE=
# Public HTTPS URL Telegram POSTs updates to (webhook mode only), e.g.
# https://<app>.koyeb.app/webhook/telegram
NEXUS_WEBHOOK_URL=
# Shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NEXUS_WEBHOOK_SECRET=

# ── Dashboard API hardening ──
# Browser origins allowed to call the API cross-origin (comma-separated).
# Empty (default) = no cross-origin browser access (dashboard is same-origin).
NEXUS_API_CORS_ORIGINS=
# Fail-closed: unset/empty disables POST /creative/video-edit (503
# "Security configuration incomplete"). When set, that endpoint requires
# an HMAC-SHA256 signature:
# X-NEXUS-Timestamp: <unix seconds>
# X-NEXUS-Signature: hex(HMAC-SHA256(key, "<timestamp>:<raw body>"))
NEXUS_API_HMAC_KEY=

# ── v3.9.0: Cloudflare R2 — technical blob tier (DB backups, heavy RAG docs) ──
# R2 is NOT part of the user-file round-robin; it stores maintenance blobs only.
# 1) Dash → R2 → "Create bucket" (default settings are fine).
# 2) Dash → R2 → Manage R2 API Tokens → "Create API Token" →
#    Permissions: Object Read & Write · Scope: "Apply to specific buckets only"
#    → select ONLY your bucket. Copy the Access Key ID / Secret Access Key.
# 3) Account ID: shown on the right side of the R2 overview page.
# Full guide: docs/r2-storage.md. Leave empty to disable the blob tier.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Wave 3: /imagine and opt-in /slideshow --slides N --fill <title> ──
# Only the owner / NEXUS_ALLOWED_USER_IDS may request these generation paths.
# No automatic fallback from Pollinations to a paid provider.
NEXUS_IMAGE_GEN_PROVIDER=pollinations
NEXUS_IMAGE_GEN_PAID_TIER=false
NEXUS_CREATIVE_GEMINI_API_KEY=
NEXUS_IMAGE_GEN_MODEL=gemini-2.5-flash-image
# Required positive operator estimate for Gemini, NOT a live tariff or budget cap.
# Confirm provider pricing and billing before changing paid_tier to true.
NEXUS_IMAGE_GEN_ESTIMATED_COST_USD=0
