+def test_remote_branch_boards_reports_a_board_that_is_unreadable_late(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """An unreadable board in a later batch is unreadable, not absent."""
+    branches = [f"arena/b{index}" for index in range(30)]
+    boards: dict[str, dict | str | None] = {
+        branch: _leased_board(f"t-{branch}", "src/x/", branch) for branch in branches
+    }
+    boards["arena/b27"] = "{not json"  # valid fetch, corrupt board, batch 2
+    del boards["arena/b26"]  # valid fetch, no board file, batch 2
+    fake = FakeGit(boards=boards)
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards_out, unreadable = board_module._remote_branch_boards(branches)
+
+    names = [name for name, _board in boards_out]
+    assert "branch:arena/b25" in names, "batch 1 is unaffected"
+    assert "branch:arena/b26" not in names and "branch:arena/b27" not in names
+    assert any("arena/b26" in reason and "no readable" in reason for reason in unreadable)
+    assert any("arena/b27" in reason and "not valid JSON" in reason for reason in unreadable)
+    assert len(boards_out) == len(branches) - 2
+
