+def test_remote_branch_boards_fallback_is_bounded_by_its_own_batch(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A failed batch only degrades *that* batch; the others stay fast-path."""
+    branches = [f"arena/b{index}" for index in range(30)]
+
+    class _OneBadBatch(FakeGit):
+        def __call__(self, args: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
+            if args and args[0] == "fetch" and len(args) > 4:
+                refspecs = [arg for arg in args if arg.startswith("+refs/heads/")]
+                targets = [spec.split("refs/heads/", 1)[1].split(":", 1)[0] for spec in refspecs]
+                # The second batch contains a branch deleted after enumeration.
+                if "arena/b29" in targets:
+                    self.fetches.append(refspecs)
+                    return subprocess.CompletedProcess(args, 128, stdout="", stderr="dead ref")
+            return super().__call__(args, cwd)
+
+    fake = _OneBadBatch(
+        boards={branch: _leased_board(f"t-{branch}", "src/x/", branch) for branch in branches},
+        fetch_fails={"arena/b29"},
+    )
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards, unreadable = board_module._remote_branch_boards(branches)
+
+    assert len(boards) == 29, "a branch deleted after enumeration costs only that branch"
+    assert "branch:arena/b28" in [name for name, _board in boards]
+    assert "branch:arena/b29" not in [name for name, _board in boards]
+    assert any("arena/b29" in reason for reason in unreadable)
+
+
