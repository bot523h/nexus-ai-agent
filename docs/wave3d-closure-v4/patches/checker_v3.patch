+def test_check_sees_a_lease_beyond_the_old_25_branch_boundary(
+    board_module: ModuleType,
+    monkeypatch: pytest.MonkeyPatch,
+    _local_board: Path,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """The false-clear regression, end to end.
+
+    A conflicting lease lives on branch #60 of 80 — far past the old 25-branch
+    slice. The referee must return ``1`` (a proven overlap). Under the old
+    implementation the branch was never fetched, so the referee returned ``0``:
+    a green gate over a live conflict.
+    """
+    branches = [f"arena/b{index}" for index in range(80)]
+    intruder = "arena/b60"
+    fake_api = FakeGitHub([_pr(index + 1, branch) for index, branch in enumerate(branches)])
+    monkeypatch.setattr(board_module, "_gh_get", fake_api)
+    monkeypatch.setattr(board_module, "_read_remote_board", lambda: ({"claims": []}, ""))
+
+    boards = {
+        branch: _leased_board(f"t-{branch}", f"src/exclusive/{branch}/", branch)
+        for branch in branches
+    }
+    boards[intruder] = _leased_board("task-intruder", "src/exclusive/", intruder)
+    monkeypatch.setattr(board_module, "_git", FakeGit(boards=boards))
+
+    code = board_module.cmd_check(_check_args())
+
+    assert code == 1, "a lease on branch #60 is a real conflict and must be seen"
+    assert "task-intruder" in capsys.readouterr().out
+
