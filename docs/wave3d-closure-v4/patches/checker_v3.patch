@@ -0,0 +1,707 @@
+"""Source-inventory regressions for the coordination referee (checker v3).
+
+The referee's promise is *"no overlap" is only said about data that was actually
+read*. Two silent caps used to break that promise for this repository, which
+already carries more than one page of open PRs:
+
+* ``_open_pr_branches`` made exactly **one** GitHub request (``per_page=100``),
+  so every branch past the first page of open PRs was invisible;
+* ``_remote_branch_boards`` sliced its target list to ``25`` and reported nothing
+  about the discarded branches, so a live lease on branch #26 produced a clean
+  ``exit 0`` — a false clear, the worst possible outcome for a gate.
+
+These tests pin the repaired contract: the inventory is **complete** (paginated,
+de-duplicated, batched but never truncated), the fetch batches are **bounded**
+at 25 refspecs, only refs fetched in this very invocation are read, and every
+failure mode degrades to *unreadable* (``exit 2``), never to a pass.
+
+Two harness rules keep the tests honest:
+
+* fakes parse the request URL **structurally** (``urllib.parse`` + ``parse_qsl``)
+  — substring matching would let ``"page=1"`` match ``"per_page=100"`` and hide
+  a pagination bug behind passing tests;
+* every test runs under a bounded watchdog (:func:`_bounded_test_runtime`), so a
+  regression that loops forever fails in seconds with a readable message
+  instead of hanging CI.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import signal
+import subprocess
+import urllib.parse
+from collections.abc import Mapping
+from pathlib import Path
+from types import ModuleType
+
+import pytest
+
+REPO_ROOT = Path(__file__).parents[2]
+SCRIPT = REPO_ROOT / "scripts" / "agent_board.py"
+API_ORIGIN = "https://api.github.com"
+PULLS_PATH = "/repos/o/r/pulls"
+
+_TEST_RUNTIME_BOUND_SECONDS = 20.0
+
+
+def _load_board_module() -> ModuleType:
+    spec = importlib.util.spec_from_file_location("agent_board_inventory", SCRIPT)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture(scope="module")
+def board_module() -> ModuleType:
+    return _load_board_module()
+
+
+@pytest.fixture(autouse=True)
+def _bounded_test_runtime() -> object:
+    """Fail loudly in seconds if a pagination loop regresses into a hang.
+
+    ``signal.setitimer`` is armed for the duration of every test in this module;
+    a test that exceeds the bound fails with the test's own name and the bound
+    instead of stalling the whole suite until the CI job is killed.
+    """
+    if not hasattr(signal, "SIGALRM"):  # pragma: no cover - non-POSIX platform
+        yield
+        return
+
+    def _expired(signum: int, frame: object) -> None:
+        raise AssertionError(
+            f"test exceeded the {_TEST_RUNTIME_BOUND_SECONDS:g}s bounded runtime — "
+            "a pagination/batch loop is not terminating; inspect the fake's call log"
+        )
+
+    previous = signal.signal(signal.SIGALRM, _expired)
+    signal.setitimer(signal.ITIMER_REAL, _TEST_RUNTIME_BOUND_SECONDS)
+    try:
+        yield
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        signal.signal(signal.SIGALRM, previous)
+
+
+# --------------------------------------------------------------------------- #
+# structural fakes
+# --------------------------------------------------------------------------- #
+class FakeGitHub:
+    """A paginated ``/repos/o/r/pulls`` endpoint that records structural queries.
+
+    ``prs`` is the full open-PR collection. The fake serves it in ``per_page``
+    slices and records every request as ``(path, page, per_page)`` *parsed from
+    the URL* — never matched as a substring, so a request that asks for
+    ``per_page=100&page=1`` can never be mistaken for ``page=1``.
+    """
+
+    def __init__(self, prs: list[dict]) -> None:
+        self.prs = prs
+        self.requests: list[tuple[str, int | None, int | None]] = []
+        self.fail_pages: dict[int, Exception] = {}
+        self.malformed_pages: dict[int, object] = {}
+
+    def __call__(self, url: str, token: str | None) -> object:
+        parsed = urllib.parse.urlsplit(url)
+        query = dict(urllib.parse.parse_qsl(parsed.query))
+        page = int(query["page"]) if "page" in query else None
+        per_page = int(query["per_page"]) if "per_page" in query else None
+        self.requests.append((parsed.path, page, per_page))
+        assert query.get("state") == "open", f"the referee must ask for open PRs, got {url!r}"
+        if page in self.fail_pages:
+            raise self.fail_pages[page]
+        if page in self.malformed_pages:
+            return self.malformed_pages[page]
+        size = per_page if per_page is not None else 30
+        start = ((page or 1) - 1) * size
+        return self.prs[start : start + size]
+
+    def pages_requested(self) -> list[int]:
+        return [page for _path, page, _per in self.requests if page is not None]
+
+    def per_page_values(self) -> set[int | None]:
+        return {per for _path, _page, per in self.requests}
+
+
+def _pr(number: int, branch: str) -> dict:
+    return {"number": number, "head": {"ref": branch}, "title": f"pr-{number}"}
+
+
+def _branch_prs(count: int, prefix: str = "arena/b") -> list[dict]:
+    return [_pr(index + 1, f"{prefix}{index}") for index in range(count)]
+
+
+class FakeGit:
+    """A ``git`` double that records every command and answers by command shape.
+
+    ``fetch_ok`` decides per-refspec whether a *per-branch* fetch succeeds;
+    ``batch_fails`` forces every multi-refspec (batch) fetch to fail, which is
+    how a branch deleted between the PR list and the fetch behaves in practice.
+    ``show`` answers from ``boards``; an absent key is a missing board file.
+    """
+
+    def __init__(
+        self,
+        boards: Mapping[str, dict | str | None] | None = None,
+        *,
+        batch_fails: bool = False,
+        fetch_fails: set[str] | None = None,
+    ) -> None:
+        self.boards: dict[str, dict | str | None] = dict(boards or {})
+        self.batch_fails = batch_fails
+        self.fetch_fails = fetch_fails or set()
+        self.fetches: list[list[str]] = []
+        self.shows: list[str] = []
+
+    def __call__(self, args: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
+        if args and args[0] == "fetch":
+            refspecs = [arg for arg in args if arg.startswith("+refs/heads/")]
+            self.fetches.append(refspecs)
+            targets = [spec.split("refs/heads/", 1)[1].split(":", 1)[0] for spec in refspecs]
+            if len(refspecs) > 1 and self.batch_fails:
+                return subprocess.CompletedProcess(args, 128, stdout="", stderr="dead ref")
+            if any(target in self.fetch_fails for target in targets):
+                return subprocess.CompletedProcess(args, 128, stdout="", stderr="unreachable")
+            return subprocess.CompletedProcess(args, 0, stdout="", stderr="")
+        if args and args[0] == "show":
+            ref = args[1]
+            self.shows.append(ref)
+            branch = ref.split("refs/remotes/origin/", 1)[1].split(":", 1)[0]
+            payload = self.boards.get(branch)
+            if payload is None:
+                return subprocess.CompletedProcess(args, 128, stdout="", stderr="no board")
+            text = payload if isinstance(payload, str) else json.dumps(payload)
+            return subprocess.CompletedProcess(args, 0, stdout=text, stderr="")
+        return subprocess.CompletedProcess(args, 1, stdout="", stderr="")
+
+    def batch_calls(self) -> list[list[str]]:
+        return [call for call in self.fetches if len(call) > 1]
+
+    def single_calls(self) -> list[list[str]]:
+        return [call for call in self.fetches if len(call) == 1]
+
+
+def _leased_board(task: str, path: str, branch: str) -> dict:
+    return {
+        "schema": 2,
+        "protocol": {"protocol_version": 2},
+        "claims": [
+            {
+                "task": task,
+                "zone": "synthetic",
+                "status": "active",
+                "agent_branch": branch,
+                "claimed_at": "2026-10-01T00:00:00Z",
+                "ttl_hours": 100000,
+                "gates_owner": False,
+                "exclusive_paths": [path],
+            }
+        ],
+    }
+
+
+# --------------------------------------------------------------------------- #
+# _open_pr_branches: pagination, de-duplication, fail-closed
+# --------------------------------------------------------------------------- #
+@pytest.mark.parametrize(
+    ("pr_count", "expected_pages"),
+    [
+        (0, [1]),
+        (1, [1]),
+        (99, [1]),
+        (100, [1, 2]),
+        (101, [1, 2]),
+        (200, [1, 2, 3]),
+        (250, [1, 2, 3]),
+    ],
+)
+def test_open_pr_branches_paginates_the_whole_inventory(
+    board_module: ModuleType,
+    monkeypatch: pytest.MonkeyPatch,
+    pr_count: int,
+    expected_pages: list[int],
+) -> None:
+    """Every open PR is enumerated; the page count follows ``ceil(n / 100)``.
+
+    ``100`` and ``200`` are the exact-multiple boundaries: the API answers with a
+    full page and the terminal page is *empty*, so a loop that stops on
+    ``len(page) < per_page`` must still issue the extra request.
+    """
+    fake = FakeGitHub(_branch_prs(pr_count))
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert reason == "", f"a readable, complete inventory must not report {reason!r}"
+    assert branches == [f"arena/b{index}" for index in range(pr_count)]
+    assert fake.pages_requested() == expected_pages
+    assert fake.per_page_values() == {100}, "pagination must always ask for a full page"
+
+
+def test_open_pr_branches_deduplicates_head_branch_names(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Several open PRs may share one head branch; it is one branch, not three."""
+    fake = FakeGitHub(
+        [
+            _pr(1, "arena/shared"),
+            _pr(2, "arena/other"),
+            _pr(3, "arena/shared"),
+            _pr(4, "arena/shared"),
+        ]
+    )
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert reason == ""
+    assert branches == ["arena/shared", "arena/other"], "order-preserving de-duplication"
+
+
+def test_open_pr_branches_deduplicates_across_a_page_boundary(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """De-duplication spans pages — the same branch may appear on both."""
+    prs = _branch_prs(99)  # arena/b0 … arena/b98
+    prs.append(_pr(100, "arena/b0"))  # page 1, slot 100: duplicates slot 1
+    prs.append(_pr(101, "arena/cross"))  # page 2
+    prs.append(_pr(102, "arena/b0"))  # page 2: duplicates a page-1 branch
+    fake = FakeGitHub(prs)
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert reason == ""
+    assert fake.pages_requested() == [1, 2], "102 rows => page 1 full, page 2 short"
+    assert branches.count("arena/b0") == 1, "a duplicate on page 2 is still a duplicate"
+    assert len(branches) == 100  # arena/b0 … arena/b98 plus arena/cross
+
+
+def test_open_pr_branches_fails_closed_when_a_later_page_fails(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A page failure must not be reported as a smaller complete inventory."""
+    fake = FakeGitHub(_branch_prs(250))
+    fake.fail_pages[3] = OSError("connection reset by peer")
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert branches == [], "a partial inventory must never be returned as complete"
+    assert "page 3" in reason
+    assert "unavailable" in reason
+    assert fake.pages_requested() == [1, 2, 3], "it must stop at the failed page"
+
+
+def test_open_pr_branches_fails_closed_on_a_malformed_later_page(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A non-list payload on any page is unreadable, not an empty page."""
+    fake = FakeGitHub(_branch_prs(250))
+    fake.malformed_pages[2] = {"message": "rate limited"}
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert branches == []
+    assert "unexpected payload" in reason and "page 2" in reason
+
+
+def test_open_pr_branches_fails_closed_on_a_malformed_first_page(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The pre-existing contract is preserved: a bad first page is unreadable."""
+    fake = FakeGitHub([])
+    fake.malformed_pages[1] = ["not", "a", "dict", "list", "of", "prs"]
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert branches == []
+    # A list of non-dict rows is a *readable* list with nothing usable in it —
+    # the referee still reports zero branches rather than inventing names.
+    assert reason == ""
+
+
+def test_open_pr_branches_aborts_a_never_ending_pagination(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """An API that always answers "100 more" must abort, not spin forever."""
+    monkeypatch.setattr(board_module, "_MAX_PR_PAGES", 4)
+
+    class _Endless(FakeGitHub):
+        def __call__(self, url: str, token: str | None) -> object:
+            parsed = urllib.parse.urlsplit(url)
+            query = dict(urllib.parse.parse_qsl(parsed.query))
+            page = int(query["page"])
+            self.requests.append((parsed.path, page, int(query["per_page"])))
+            return _branch_prs(100, prefix=f"arena/p{page}/")
+
+    fake = _Endless([])
+    monkeypatch.setattr(board_module, "_gh_get", fake)
+
+    branches, reason = board_module._open_pr_branches("o/r", "token")
+
+    assert branches == []
+    assert "exceeded" in reason and "partial" in reason
+    assert fake.pages_requested() == [1, 2, 3, 4]
+
+
+# --------------------------------------------------------------------------- #
+# _remote_branch_boards: bounded batches, no truncation
+# --------------------------------------------------------------------------- #
+@pytest.mark.parametrize(
+    ("branch_count", "expected_batches"),
+    [
+        (0, 0),
+        (1, 1),
+        (24, 1),
+        (25, 1),
+        (26, 2),
+        (49, 2),
+        (50, 2),
+        (51, 3),
+        (200, 8),
+        (201, 9),
+    ],
+)
+def test_remote_branch_boards_reads_every_branch_in_bounded_batches(
+    board_module: ModuleType,
+    monkeypatch: pytest.MonkeyPatch,
+    branch_count: int,
+    expected_batches: int,
+) -> None:
+    """No inventory cap: n branches => ceil(n/25) batches of at most 25 refspecs."""
+    branches = [f"arena/b{index}" for index in range(branch_count)]
+    fake = FakeGit(
+        boards={branch: _leased_board(f"t-{branch}", "src/x/", branch) for branch in branches}
+    )
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards, unreadable = board_module._remote_branch_boards(branches)
+
+    assert unreadable == []
+    assert [name for name, _board in boards] == [f"branch:{branch}" for branch in branches]
+    # Every batch succeeded, so every `git fetch` in the log *is* a batch: one
+    # call per slice. A silent inventory cap shows up here as fewer calls.
+    assert len(fake.fetches) == expected_batches, (
+        f"{branch_count} branches must take {expected_batches} bounded fetch(es), "
+        f"got {len(fake.fetches)}: {fake.fetches!r}"
+    )
+    oversized = [call for call in fake.fetches if len(call) > 25]
+    assert oversized == [], f"a fetch exceeded the 25-refspec bound: {oversized}"
+
+
+@pytest.mark.parametrize("branch_count", [0, 1, 25, 26, 51])
+def test_remote_branch_boards_deduplicates_before_fetching(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch, branch_count: int
+) -> None:
+    """A branch name repeated across PRs is fetched exactly once."""
+    unique = [f"arena/b{index}" for index in range(branch_count)]
+    doubled = [branch for pair in ((b, b) for b in unique) for branch in pair]
+    fake = FakeGit(
+        boards={branch: _leased_board(f"t-{branch}", "src/x/", branch) for branch in unique}
+    )
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards, unreadable = board_module._remote_branch_boards(doubled)
+
+    assert unreadable == []
+    assert [name for name, _board in boards] == [f"branch:{branch}" for branch in unique]
+    refspecs = [spec for call in fake.fetches for spec in call]
+    assert len(refspecs) == len(set(refspecs)) == branch_count
