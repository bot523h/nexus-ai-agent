+def test_remote_branch_boards_recovers_a_failed_batch_per_branch(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """One dead ref fails its batch; the healthy branches must still be read."""
+    fake = FakeGit(
+        boards={"arena/good": _leased_board("t-good", "src/x/", "arena/good")},
+        batch_fails=True,
+        fetch_fails={"arena/dead"},
+    )
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards, unreadable = board_module._remote_branch_boards(["arena/good", "arena/dead"])
+
+    assert [name for name, _board in boards] == ["branch:arena/good"]
+    assert len(fake.batch_calls()) == 1
+    assert sorted(
+        call[0].split("refs/heads/", 1)[1].split(":", 1)[0] for call in fake.single_calls()
+    ) == [
+        "arena/dead",
+        "arena/good",
+    ]
+    assert any("arena/dead" in reason and "fetch failed" in reason for reason in unreadable)
+
