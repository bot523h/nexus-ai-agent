+def test_remote_branch_boards_reads_only_freshly_fetched_refs(
+    board_module: ModuleType, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A stale tracking ref left by an earlier run is not current evidence.
+
+    The fetch of ``arena/stale`` fails (branch deleted), yet its
+    ``refs/remotes/origin/arena/stale`` ref is still resolvable locally. Reading
+    it would resurrect a lease that no longer exists on the remote.
+    """
+    fake = FakeGit(
+        boards={
+            "arena/fresh": _leased_board("t-fresh", "src/x/", "arena/fresh"),
+            "arena/stale": _leased_board("t-stale", "src/y/", "arena/stale"),
+        },
+        batch_fails=True,
+        fetch_fails={"arena/stale"},
+    )
+    monkeypatch.setattr(board_module, "_git", fake)
+
+    boards, unreadable = board_module._remote_branch_boards(["arena/fresh", "arena/stale"])
+
+    assert [name for name, _board in boards] == ["branch:arena/fresh"]
+    assert not any("arena/stale" in ref for ref in fake.shows), (
+        f"a stale tracking ref must never be read; shows={fake.shows!r}"
+    )
+    assert any("arena/stale" in reason for reason in unreadable)
+
