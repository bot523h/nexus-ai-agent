+def _check_args(**overrides: object) -> object:
+    defaults: dict[str, object] = {
+        "files": "src/exclusive/x.py",
+        "branch": "arena/me",
+        "no_remote": False,
+        "repo": "o/r",
+        "token": "t",
+    }
+    defaults.update(overrides)
+    return type("A", (), defaults)()
